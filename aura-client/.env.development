# Aura Client Development Environment
# This file is used automatically when running 'npm run dev'

# Backend API Base URL
VITE_API_BASE=http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000

# AURA Mock Mode - DISABLED to use real Gemini transcription
# Provides instant mock transcription and fast content generation
VITE_AURA_MOCK_MODE=false

# Intelligence Pipeline Enabled
VITE_INTELLIGENCE_ENABLED=true

# Authentication
VITE_AUTH_ENABLED=true

# Development Authentication Token
VITE_DEV_AUTH_TOKEN=dev-mock-token

# Legacy settings (for backward compatibility)
VITE_USE_REAL_TRANSCRIPTION=true
VITE_USE_REAL_API=true
