# Aura Client Environment Variables

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000

# Alternative: Production API
# VITE_API_BASE_URL=https://api.aura-realestate.com

# AURA Mock Mode (NEW - Unified Intelligence Pipeline)
# Set to 'true' to enable mock mode for development and testing
# - Mock transcription returns predefined prompts instantly
# - Mock content generation uses fast synthetic responses
# Set to 'false' for production with real AI processing
VITE_AURA_MOCK_MODE=true

# Intelligence Pipeline Enabled
# Set to 'true' to use the new unified intelligence API
VITE_INTELLIGENCE_ENABLED=true

# Legacy Transcription Mode (DEPRECATED - use VITE_AURA_MOCK_MODE instead)
# Set to 'true' to use real voice transcription via backend API
# Set to 'false' to use mock transcriptions (faster, no API required)
VITE_USE_REAL_TRANSCRIPTION=false

# API Mode
# Set to 'true' to use real backend APIs for workflows (CMA, reports, social posts)
# Set to 'false' to use mock responses (faster, no backend required)
VITE_USE_REAL_API=false

# Development Authentication Token
# Used as fallback when no user auth token is available in localStorage
# Prevents 403 Forbidden errors during development
VITE_DEV_AUTH_TOKEN=dev-mock-token
