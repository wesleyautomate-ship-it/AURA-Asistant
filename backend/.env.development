# PropertyPro AI - Development Environment Configuration
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Database - Use SQLite for local development
DATABASE_URL=sqlite:///./propertypro_dev.db

# CORS Configuration - Allow frontend on localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Development Auth Bypass
DISABLE_AUTH=true

# Optional: Disable other integrations for local dev
GOOGLE_API_KEY=
CHROMA_HOST=localhost
CHROMA_PORT=8002
REDIS_URL=redis://localhost:6379

# Security (dev defaults)
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO