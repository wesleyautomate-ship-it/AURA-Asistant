# PropertyPro AI - Development Environment Configuration
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Database - Use SQLite for local development
DATABASE_URL=sqlite:///./propertypro_dev.db

# CORS Configuration - Allow local frontends
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Development Auth Bypass
DEV_AUTH_ALLOW=0
DISABLE_AUTH=false

# AI Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=AIzaSyAVHIS69nuR4NSbm39PMvI3XDhQwQlHn5A
GEMINI_MODEL=gemini-2.0-flash
GEMINI_STT=true
GOOGLE_API_KEY=AIzaSyAVHIS69nuR4NSbm39PMvI3XDhQwQlHn5A
CHROMA_HOST=localhost
CHROMA_PORT=8002
REDIS_URL=redis://localhost:6379

# Security (dev defaults)
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Optional features (disabled by default)
ENABLE_PDF_WEASYPRINT=true
ENABLE_VECTOR_CHROMA=0
